APP_NAME="KKK OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Production baseline:
# LOG_CHANNEL=daily
# LOG_LEVEL=info
# LOG_DAILY_DAYS=14
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Local development database.
# Production must use separate production credentials.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kkk_os_dev
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production HTTPS baseline:
# SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

# KKK OS V1 currently uses private local storage.
FILESYSTEM_DISK=local

# No asynchronous jobs currently require a persistent worker.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Production database backup is disabled until two physically separate private
# filesystem disks have been selected and configured in config/filesystems.php.
# Vendor, cost, credentials, and the second location remain a Project Owner decision.
BACKUP_ENABLED=false
BACKUP_DB_CONNECTION=mysql
BACKUP_DATABASE_DISKS=backup_primary,backup_secondary
BACKUP_DAILY_AT=02:00
BACKUP_RETENTION_DAYS=30
BACKUP_PROCESS_TIMEOUT_SECONDS=3600
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_PG_DUMP_BINARY=pg_dump

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Deposit customer. QR image path is relative to the public directory.
# Set the actual business-approved deposit amount before production use.
KKK_DEPOSIT_AMOUNT=0.00
KKK_DEPOSIT_QR_IMAGE=images/payment/deposit-qr.png

# Official KingKadKahwin social media links.
KKK_SOCIAL_INSTAGRAM=https://www.instagram.com/kingkadkahwin/
KKK_SOCIAL_FACEBOOK=https://www.facebook.com/stickingbyking/
KKK_SOCIAL_TIKTOK=
KKK_SOCIAL_WHATSAPP=https://wa.me/60187716968
